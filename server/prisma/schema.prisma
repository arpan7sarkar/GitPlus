generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users (GitHub OAuth) ───────────────────────────────────────────────────────
// One row per GitHub account that has ever signed in. `accessToken` is the user's
// GitHub OAuth token, AES-256-GCM encrypted at rest (see server/src/lib/crypto.ts) —
// using it raises GitHub API rate limits from 60/hr (unauthenticated) to 5000/hr,
// and unlocks access to the user's private repos.
model User {
  id          String   @id @default(uuid())
  githubId    String   @unique @map("github_id")
  username    String
  name        String?
  email       String?
  avatarUrl   String?  @map("avatar_url")
  accessToken String   @map("access_token")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

    sessions         Session[]
  indexedRepos     IndexedRepo[]
  vexReviewConfigs VexReviewConfig[]

  @@map("users")
}

// ─── Sessions ────────────────────────────────────────────────────────────────
// Server-side session store backing the httpOnly `gitplus_session` cookie.
// Token itself is the opaque, high-entropy primary key (no separate id needed).
model Session {
  token     String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// ─── Indexed Repos ───────────────────────────────────────────────────────────
// One row per (user, repo) — powers the "My Repos" page. Written on every
// /api/search/ingest call made by a logged-in user; unrelated to the Node
// hierarchy itself (which has no userId — it's keyed only by repoId).
model IndexedRepo {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoId        String   @map("repo_id")
  owner         String
  name          String
  description   String?
  language      String?
  stars         Int?
  forks         Int?
  lastIndexedAt DateTime @default(now()) @map("last_indexed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, repoId])
  @@index([userId])
  @@map("indexed_repos")
}

// ─── VexReview (AI PR Reviewer) ──────────────────────────────────────────────
// "Add the action" = create one of these rows (no files written to the user's
// repo, no GitHub Actions involved — the review engine runs inside this server,
// using the user's own stored GitHub token). The "review this PR" button then
// creates a VexReviewRun and runs server/src/lib/vexreview/ against it directly.
model VexReviewConfig {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner     String
  repo      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runs VexReviewRun[]

  @@unique([userId, owner, repo])
  @@index([userId])
  @@map("vexreview_configs")
}

enum VexReviewRunStatus {
  queued
  running
  completed
  failed
}

// One row per review invocation — the button click. `stage`/`stageMessage` are
// updated live while `running` so the frontend can poll for progress instead of
// holding a connection open for what can be a multi-minute LLM-heavy job.
model VexReviewRun {
  id             String             @id @default(uuid())
  configId       String             @map("config_id")
  config         VexReviewConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  userId         String             @map("user_id")
  prNumber       Int                @map("pr_number")
  status         VexReviewRunStatus @default(queued)
  stage          String?
  stageMessage   String?            @map("stage_message")
  resultStatus   String?            @map("result_status") // reviewed | skipped | rejected_sensitive_files
  filesReviewed  Int?               @map("files_reviewed")
  reviewComments Int?               @map("review_comments")
  lgtmCount      Int?               @map("lgtm_count")
  error          String?
  startedAt      DateTime           @default(now()) @map("started_at")
  completedAt    DateTime?          @map("completed_at")

  @@index([configId])
  @@index([userId, startedAt])
  @@map("vexreview_runs")
}

// ─── Chat Sessions ─────────────────────────────────────────────────────────────
// Persists chat history per repo. Used by SharedChat (/shared/:sessionId).
model ChatSession {
  id          String   @id @default(uuid())
  repoId      String   @map("repo_id")
  userId      String?  @map("user_id")
  repoMeta    Json     @default("{}") @map("repo_meta")
  messages    Json     @default("[]")
  repoContext String   @default("") @map("repo_context")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([repoId])
  @@index([userId])
  @@map("chat_sessions")
}

// ─── Visitor Analytics ─────────────────────────────────────────────────────────
// Powers the live visitor counter on the Landing page.
model Visit {
  id        String   @id @default(uuid())
  visitorId String   @map("visitor_id")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitorId])
  @@index([createdAt])
  @@map("visits")
}

// ─── Nodes (Hierarchical Vector Search Metadata Mirror) ─────────────────────────
// One unified table for all 4 tiers of the retrieval hierarchy: repo -> module ->
// file -> symbol. Mirrors what's embedded and stored in Actian VectorAI, plus the
// "huge context" fields (full file content, LLM summaries) Actian doesn't need to
// hold — this table is what keyword search runs against and what retrieval walks
// up `parentId` to expand a small symbol hit into its surrounding file/module/repo
// context before handing it to the LLM.
enum NodeLevel {
  repo
  module
  file
  symbol
}

model Node {
  id               String    @id
  repoId           String    @map("repo_id")
  level            NodeLevel
  parentId         String?   @map("parent_id")
  parent           Node?     @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         Node[]    @relation("NodeHierarchy")

  filePath         String?   @map("file_path") // set at file/symbol level, null for module/repo
  symbolName       String?   @map("symbol_name") // symbol level only
  parentSymbolPath String?   @map("parent_symbol_path") // e.g. enclosing class name, for methods
  symbolType       String?   @map("symbol_type") // function|class|method|interface|enum|type|config
  language         String?
  startLine        Int?      @map("start_line")
  endLine          Int?      @map("end_line")

  code             String?   // raw source, symbol level only
  content          String?   // full raw file text, file level only ("huge context")
  summary          String?   // LLM-generated summary, file/module/repo level
  embeddingText    String    @default("") @map("embedding_text") // what was actually embedded + what keyword search runs against

  category         String?
  contentHash      String    @default("") @map("content_hash")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([repoId])
  @@index([repoId, level])
  @@index([parentId])
  @@index([filePath])
  @@index([category])
  @@map("nodes")
}

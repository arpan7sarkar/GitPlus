generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users (GitHub OAuth) ───────────────────────────────────────────────────────
// One row per GitHub account that has ever signed in. `accessToken` is the user's
// GitHub OAuth token, AES-256-GCM encrypted at rest (see server/src/lib/crypto.ts) —
// using it raises GitHub API rate limits from 60/hr (unauthenticated) to 5000/hr,
// and unlocks access to the user's private repos.
model User {
  id          String   @id @default(uuid())
  githubId    String   @unique @map("github_id")
  username    String
  name        String?
  email       String?
  avatarUrl   String?  @map("avatar_url")
  accessToken String   @map("access_token")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

// ─── Sessions ────────────────────────────────────────────────────────────────
// Server-side session store backing the httpOnly `gitplus_session` cookie.
// Token itself is the opaque, high-entropy primary key (no separate id needed).
model Session {
  token     String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// ─── Chat Sessions ─────────────────────────────────────────────────────────────
// Persists chat history per repo. Used by SharedChat (/shared/:sessionId).
model ChatSession {
  id          String   @id @default(uuid())
  repoId      String   @map("repo_id")
  userId      String?  @map("user_id")
  repoMeta    Json     @default("{}") @map("repo_meta")
  messages    Json     @default("[]")
  repoContext String   @default("") @map("repo_context")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([repoId])
  @@index([userId])
  @@map("chat_sessions")
}

// ─── Visitor Analytics ─────────────────────────────────────────────────────────
// Powers the live visitor counter on the Landing page.
model Visit {
  id        String   @id @default(uuid())
  visitorId String   @map("visitor_id")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitorId])
  @@index([createdAt])
  @@map("visits")
}

// ─── Code Chunks (Vector Search Metadata Mirror) ────────────────────────────────
// Mirrors the metadata of chunks stored in Actian VectorAI.
// Used for keyword search (BM25-style) and for hybrid RRF fusion.
model CodeChunk {
  id          String   @id
  repoId      String   @map("repo_id")
  filePath    String   @map("file_path")
  codeSnippet String   @map("code_snippet")
  startLine   Int      @map("start_line")
  endLine     Int      @map("end_line")
  language    String
  symbolType  String   @map("symbol_type")
  category    String
  contentHash String   @default("") @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([repoId])
  @@index([category])
  @@index([filePath])
  @@map("code_chunks")
}

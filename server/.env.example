# GitPlus server configuration — copy to .env and fill in real values.
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:8080
NODE_ENV=development

# ─── Postgres (local Docker or Neon) ──────────────────────────────────────────
# Local Docker (see docker-compose.yml):
DATABASE_URL=postgresql://neondb_owner:neondb_password@localhost:5432/neondb

# ─── Pinecone vector store ────────────────────────────────────────────────────
# The server validates this index on boot and per request (server/src/lib/
# pinecone.ts) but never creates or modifies it: create a dense, cosine-metric,
# 1024-dimension index in the Pinecone console, then paste its values here.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=https://<your-index>.svc.<region>.pinecone.io
# Namespace isolating GitPlus records inside the index (default: gitplus).
PINECONE_NAMESPACE=gitplus

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Explicit provider selection — "openai" (default) or "gemini". There is no
# automatic fallback: vectors from different models live in incompatible
# spaces, so a missing key for the configured provider is a clear error.
# Changing provider/model after ingesting requires re-ingesting affected
# repos (POST /api/search/ingest); query time rejects the mismatch otherwise.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Optional model overrides (defaults shown):
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# GOOGLE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_MODEL=              # generic override for the active provider
# EMBEDDING_DIMENSIONS=1024     # must match the Pinecone index dimension
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=    # optional override for the OAuth callback
ENCRYPTION_KEY=                 # 32 bytes as 64 hex chars; encrypts stored GitHub tokens
